---
// src/pages/iscrizione-uscita.astro - OASY ASD: Iscrizione Singola o Multipla Ufficiale
---
<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iscrizione Uscite Ufficiali | Outdoor Activity Sassello ASD</title>
    
    <!-- Meta SEO & Social Preview -->
    <meta name="title" content="Iscrizione Uscite OASY | Sassello" />
    <meta name="description" content="Modulo ufficiale di registrazione e copertura assicurativa per le uscite e gli eventi di Outdoor Activity Sassello ASD." />
    <link rel="icon" type="image/png" href="/logo.png" />

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@600;800&display=swap" rel="stylesheet" />

    <style is:inline>
      :root {
        --rock: #111110;
        --trail: #2d2d20;
        --energy: #c7cf0b;
        --sand: #f9f7ed;
        --sand-card: #ffffff;
        --water: #a5d5d7;
        --autumn: #d96919;
        --border-subtle: rgba(45, 45, 32, 0.14);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--sand);
        color: var(--rock);
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.5;
        overflow-x: hidden;
      }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
      .tag-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .ticker {
        background: var(--trail);
        color: var(--sand);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        padding: 8px 24px;
        display: flex;
        justify-content: space-between;
      }

      header {
        position: sticky;
        top: 0;
        background: rgba(249, 247, 237, 0.95);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(45, 45, 32, 0.12);
        padding: 12px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 90;
      }

      .logo-img { height: 44px; width: auto; display: block; }

      .back-link {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--trail);
        text-decoration: none;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(45, 45, 32, 0.06);
        transition: background-color 0.2s, color 0.2s;
      }
      .back-link:hover {
        background: var(--rock);
        color: var(--sand);
      }

      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 30px 16px 80px;
      }

      .form-hero {
        background: var(--rock);
        color: var(--sand);
        border-radius: 24px;
        padding: 36px 24px;
        margin-bottom: 24px;
      }

      .form-tag {
        display: inline-block;
        background: rgba(199, 207, 11, 0.18);
        color: var(--energy);
        border: 1px solid rgba(199, 207, 11, 0.4);
        font-size: 11px;
        font-weight: 800;
        padding: 5px 12px;
        border-radius: 999px;
        margin-bottom: 12px;
      }

      h1 {
        font-size: clamp(1.9rem, 4vw, 2.8rem);
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.05;
        margin-bottom: 10px;
      }

      .form-card {
        background: #ffffff;
        border: 1.5px solid var(--border-subtle);
        border-radius: 24px;
        padding: 28px 22px;
        box-shadow: 0 8px 28px rgba(45, 45, 32, 0.05);
      }

      .form-group { margin-bottom: 20px; }

      .form-label {
        display: block;
        font-size: 12.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--rock);
        margin-bottom: 6px;
      }

      .form-input, .form-select, .form-textarea {
        width: 100%;
        background: var(--sand);
        border: 1.5px solid rgba(45, 45, 32, 0.2);
        border-radius: 12px;
        padding: 12px 14px;
        font-family: inherit;
        font-size: 14.5px;
        color: var(--rock);
        outline: none;
      }

      .form-input:focus, .form-select:focus, .form-textarea:focus {
        border-color: var(--rock);
        background: #ffffff;
      }

      .form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      @media (max-width: 600px) {
        .form-grid-2 { grid-template-columns: 1fr; }
      }

      .radio-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .radio-card {
        border: 1.5px solid rgba(45, 45, 32, 0.2);
        border-radius: 12px;
        padding: 12px;
        cursor: pointer;
        background: var(--sand);
        display: flex;
        gap: 8px;
        transition: all 0.2s ease;
      }

      .radio-card.active {
        border-color: var(--rock);
        background: #ffffff;
        box-shadow: 0 0 0 2px var(--energy);
      }

      .conditional-box {
        margin-top: 12px;
        border-radius: 12px;
        padding: 14px;
      }

      .box-non-socio-style {
        background: rgba(217, 105, 25, 0.08);
        border: 1.5px solid rgba(217, 105, 25, 0.35);
      }

      .box-socio-style {
        background: rgba(199, 207, 11, 0.12);
        border: 1.5px dashed var(--energy);
      }

      .extra-participants-section {
        margin: 28px 0 20px;
        border-top: 1.5px dashed var(--border-subtle);
        padding-top: 22px;
      }

      .participant-item-card {
        background: var(--sand);
        border: 1px solid var(--border-subtle);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 14px;
        position: relative;
      }

      .btn-remove-acc {
        position: absolute;
        top: 12px;
        right: 12px;
        background: rgba(217, 105, 25, 0.15);
        color: var(--autumn);
        border: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 6px;
        cursor: pointer;
      }

      .btn-add-participant {
        width: 100%;
        background: rgba(45, 45, 32, 0.06);
        color: var(--rock);
        border: 1.5px dashed var(--trail);
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 14px;
        border-radius: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-top: 8px;
        transition: background-color 0.2s;
      }
      .btn-add-participant:hover {
        background: rgba(45, 45, 32, 0.12);
      }

      .quota-preview {
        background: var(--trail);
        color: var(--sand);
        border-radius: 14px;
        padding: 16px 20px;
        margin: 24px 0 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .quota-num {
        font-size: 26px;
        font-weight: 900;
        color: var(--energy);
      }

      .pacco-gara-notice {
        background: rgba(199, 207, 11, 0.14);
        border: 1.5px solid var(--energy);
        border-radius: 14px;
        padding: 14px 16px;
        margin-bottom: 20px;
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--rock);
      }

      .actions-container {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn-onsite {
        width: 100%;
        background: var(--rock);
        color: var(--sand);
        border: none;
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        padding: 16px;
        border-radius: 12px;
        cursor: pointer;
        text-align: center;
        transition: background-color 0.2s;
      }

      .btn-onsite:hover {
        background: var(--trail);
      }

      .feedback-box {
        display: none;
        background: #ffffff;
        border-radius: 24px;
        padding: 40px 24px;
        text-align: center;
      }
    </style>
  </head>

  <body>
    <div class="ticker font-mono">
      <span>Sassello [SV] • Beigua Geopark UNESCO</span>
      <span>Outdoor Activity Sassello ASD • C.F. 01947540090</span>
    </div>

    <header>
      <a href="/" style="text-decoration:none;">
        <img src="/logo.png" alt="OASY" class="logo-img" onerror="this.style.display='none'" />
      </a>
      <a href="/#desktop-uscite" class="back-link">← Tutte le Uscite</a>
    </header>

    <main>
      <section class="form-hero">
        <span class="form-tag font-mono">ISCRIZIONE USCITA OASY</span>
        <h1>Prendi la tua linea.<br/>Ci vediamo al ritrovo.</h1>
        <p style="opacity: 0.88; font-size: 14px;">
          Iscrivi te stesso e i tuoi compagni di uscita: ogni nominativo riceve la regolare copertura assicurativa CSEN valida per la giornata.
        </p>
      </section>

      <div class="form-card" id="form-container">
        <form id="oasy-registration-form">
          <!-- 1. USCITA -->
          <div class="form-group">
            <label class="form-label" for="evento">Seleziona l'Uscita *</label>
            <select class="form-select font-mono" id="evento" name="evento" required>
              <option value="Raduno Babbi di Natale (Sabato 12 Dicembre)">Raduno dei Babbi di Natale (Sabato 12 Dicembre)</option>
            </select>
          </div>

          <!-- 2. PARTECIPANTE 1 -->
          <div style="background: rgba(45,45,32,0.03); border: 1px solid var(--border-subtle); border-radius: 16px; padding: 18px; margin-bottom: 20px;">
            <span class="tag-mono" style="color:var(--rock); margin-bottom: 12px; display:block;">1. DATI PARTECIPANTE PRINCIPALE</span>

            <div class="form-group">
              <label class="form-label" for="nome">Nome e Cognome *</label>
              <input type="text" class="form-input" id="nome" name="nome" placeholder="es. Marco Rossi" required />
            </div>

            <div class="form-grid-2">
              <div class="form-group">
                <label class="form-label" for="email">Email Ricezione Ricevuta *</label>
                <input type="email" class="form-input" id="email" name="email" placeholder="nome@esempio.it" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="telefono">Cellulare / WhatsApp *</label>
                <input type="tel" class="form-input font-mono" id="telefono" name="telefono" placeholder="340 1234567" required />
              </div>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label">Sei già socio tesserato OASY CSEN?</label>
              <div class="radio-group">
                <label class="radio-card active" id="card-non-socio">
                  <input type="radio" name="isSocio" value="No (Spot)" checked />
                  <div>
                    <strong style="font-size: 12px; display:block;">No (Non socio)</strong>
                    <span style="font-size: 10.5px; opacity:0.8;">Include polizza CSEN (15€)</span>
                  </div>
                </label>

                <label class="radio-card" id="card-socio">
                  <input type="radio" name="isSocio" value="Si (Socio)" />
                  <div>
                    <strong style="font-size: 12px; display:block;">Sì, Socio OASY</strong>
                    <span style="font-size: 10.5px; opacity:0.8;">Quota agevolata (12€)</span>
                  </div>
                </label>
              </div>

              <!-- CF per Non Socio -->
              <div class="conditional-box box-non-socio-style" id="box-non-socio-cf">
                <label class="form-label" for="cfAssicurazione" style="color: var(--autumn);">
                  Codice Fiscale * (Per Polizza Giornaliera Infortuni CSEN)
                </label>
                <input type="text" class="form-input font-mono" id="cfAssicurazione" placeholder="16 CARATTERI" maxlength="16" style="background:#fff; text-transform:uppercase;" />
              </div>

              <!-- Codice per Socio -->
              <div class="conditional-box box-socio-style" id="box-socio-verification" style="display:none;">
                <label class="form-label" for="numeroTessera">
                  Codice Fiscale o N° Tessera OASY / Golee *
                </label>
                <input type="text" class="form-input font-mono" id="numeroTessera" placeholder="CF o N° Tessera attiva" style="background:#fff; text-transform:uppercase;" />
              </div>
            </div>
          </div>

          <!-- 3. ACCOMPAGNATORI MULTIPLI -->
          <div class="extra-participants-section">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 12px;">
              <span class="tag-mono" style="color:var(--trail);">PARTECIPANTI AGGIUNTIVI / MINORI</span>
              <span class="tag-mono" id="acc-count-badge" style="color:var(--autumn);">0 aggiunti</span>
            </div>

            <div id="accompagnatori-list"></div>

            <button type="button" class="btn-add-participant" onclick="aggiungiAccompagnatore()">
              <span>+ Aggiungi un altro partecipante o minore</span>
            </button>
          </div>

          <!-- NOTE -->
          <div class="form-group">
            <label class="form-label" for="note">Note / Intolleranze / Tipo Mezzo</label>
            <textarea class="form-textarea" id="note" rows="2" placeholder="Solo corsa/camminata, intolleranze al ristoro..."></textarea>
          </div>

          <!-- RIEPILOGO TOTALE -->
          <div class="quota-preview">
            <div>
              <span class="font-mono" style="font-size: 11px; text-transform: uppercase; opacity: 0.75; letter-spacing: 1px; display: block;">TOTALE ISCRIZIONE</span>
              <span style="font-size: 12px; opacity: 0.85;" id="quota-detail-text">1 Partecipante</span>
            </div>
            <div class="quota-num font-mono" id="quota-display">15€</div>
          </div>

          <!-- AVVISO PACCO GARA -->
          <div class="pacco-gara-notice">
            <strong>🎅 Cappellino & Merenda Garantiti:</strong><br/>
            Il kit evento (cappellino ufficiale da Babbo Natale e buono merenda) verrà consegnato a tutti gli iscritti al momento del saldo della quota. Il pagamento avverrà esclusivamente presso il nostro banchetto accrediti prima della partenza (accettati Contanti e POS).
          </div>

          <!-- PULSANTI -->
          <div class="actions-container">
            <button type="button" class="btn-onsite" id="btn-book-onsite">
              <span>Conferma Iscrizione & Salda al Ritrovo →</span>
            </button>
          </div>
        </form>
      </div>

      <!-- FEEDBACK: PRENOTAZIONE CONFERMATA -->
      <div class="feedback-box" id="box-onsite-success" style="border: 2px solid var(--energy);">
        <div style="font-size: 32px; margin-bottom: 12px;">📝</div>
        <h2 style="font-size: 22px; font-weight: 900; text-transform: uppercase; margin-bottom: 8px;">Iscrizione Registrata!</h2>
        <p style="font-size: 14px; opacity: 0.9; margin-bottom: 18px;" id="success-message-text">
          Iscrizione confermata. Vi aspettiamo al banchetto accrediti per saldare la quota e ritirare i cappellini.
        </p>
        <a href="/" class="back-link" style="display: inline-block; background: var(--rock); color: var(--sand); padding: 12px 24px;">← Torna alla Home</a>
      </div>
    </main>

    <!-- FOOTER CONFORME STATUTO -->
    <footer style="background: var(--rock); color: var(--sand); border-top: 1px solid var(--border-subtle); padding: 40px 3vw 30px; font-size: 11.5px; line-height: 1.6;">
      <div style="max-width: 1000px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; margin-bottom: 28px;">
        <div>
          <h5 style="font-size: 12px; font-weight: 900; text-transform: uppercase; color: var(--energy); margin-bottom: 8px;">OUTDOOR ACTIVITY SASSELLO ASD</h5>
          <p style="opacity: 0.85;">
            Piazza della Concezione 11 • 17046 Sassello (SV)<br />
            Codice Fiscale: <strong>01947540090</strong>
          </p>
        </div>
        <div>
          <h5 style="font-size: 12px; font-weight: 900; text-transform: uppercase; color: var(--energy); margin-bottom: 8px;">Inquadramento</h5>
          <p style="opacity: 0.85;">
            Affiliata CSEN • Iscritta al CONI e al R.A.S.D.<br />
            Agenzia delle Entrate di Savona (Serie 3 n. 387)
          </p>
        </div>
        <div>
          <h5 style="font-size: 12px; font-weight: 900; text-transform: uppercase; color: var(--energy); margin-bottom: 8px;">Contatti & Privacy</h5>
          <p style="opacity: 0.85;">
            Email: <a href="mailto:asdoasy@gmail.com" style="color:var(--sand); text-decoration:underline;">asdoasy@gmail.com</a><br />
            I dati raccolti sono trattati esclusivamente ai fini assicurativi CSEN e organizzativi dell'evento.
          </p>
        </div>
      </div>
      <div style="max-width: 1000px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.12); padding-top: 16px; text-align: center; opacity: 0.6; font-size: 10px; font-family: 'JetBrains Mono', monospace; text-transform: uppercase;">
        © 2026 OUTDOOR ACTIVITY SASSELLO ASD • BEIGUA GEOPARK UNESCO
      </div>
    </footer>

    <script is:inline>
      var GOOGLE_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbwoRO_6odEkofRnv3KNvBsphBfhGt840QQhjrADvLcXi-ero48ZwTqdxVHYna0gJB19zA/exec";

      var currentTotalEuro = 10;
      var accompagnatori = [];

      var radioInputs = document.querySelectorAll('input[name="isSocio"]');
      var cardNonSocio = document.getElementById('card-non-socio');
      var cardSocio = document.getElementById('card-socio');
      var boxNonSocioCF = document.getElementById('box-non-socio-cf');
      var inputCF = document.getElementById('cfAssicurazione');
      var boxSocioVerification = document.getElementById('box-socio-verification');
      var inputNumeroTessera = document.getElementById('numeroTessera');

      function updateMainUserUI() {
        var isSocio = document.querySelector('input[name="isSocio"]:checked').value.includes('Si');
        if (isSocio) {
          cardSocio.classList.add('active');
          cardNonSocio.classList.remove('active');
          boxNonSocioCF.style.display = 'none';
          boxSocioVerification.style.display = 'block';
        } else {
          cardNonSocio.classList.add('active');
          cardSocio.classList.remove('active');
          boxNonSocioCF.style.display = 'block';
          boxSocioVerification.style.display = 'none';
        }
        recalculateTotal();
      }

      radioInputs.forEach(function(r) { r.addEventListener('change', updateMainUserUI); });

      window.aggiungiAccompagnatore = function() {
        var id = Date.now();
        accompagnatori.push({
          id: id,
          nome: "",
          codiceFiscale: "",
          tipo: "minore",
          quota: "6€",
          costo: 6
        });
        renderAccompagnatori();
      };

      window.rimuoviAccompagnatore = function(id) {
        accompagnatori = accompagnatori.filter(function(a) { return a.id !== id; });
        renderAccompagnatori();
      };

      window.updateAccField = function(id, field, value) {
        var acc = accompagnatori.find(function(a) { return a.id === id; });
        if (!acc) return;
        acc[field] = value;
        if (field === 'tipo_select') {
          if (value === 'adulto_standard') {
            acc.tipo = 'adulto_standard';
            acc.quota = '10€';
            acc.costo = 10;
          } else if (value === 'adulto_socio') {
            acc.tipo = 'adulto_socio';
            acc.quota = '10€';
            acc.costo = 10;
          } else {
            acc.tipo = 'minore';
            acc.quota = '6€';
            acc.costo = 6;
          }
        }
        recalculateTotal();
      };

      function renderAccompagnatori() {
        var container = document.getElementById('accompagnatori-list');
        var badge = document.getElementById('acc-count-badge');
        badge.textContent = accompagnatori.length + " aggiunti";

        container.innerHTML = accompagnatori.map(function(acc, idx) {
          return `
            <div class="participant-item-card">
              <button type="button" class="btn-remove-acc" onclick="rimuoviAccompagnatore(${acc.id})">✕ Rimuovi</button>
              <strong style="font-size:12px; text-transform:uppercase; display:block; margin-bottom:8px;">
                Partecipante #${idx + 2}
              </strong>
              
              <div class="form-group" style="margin-bottom:10px;">
                <label class="form-label" style="font-size:11px;">Tipologia Partecipante *</label>
                <select class="form-select font-mono" style="padding:8px 10px; font-size:13px;" onchange="updateAccField(${acc.id}, 'tipo_select', this.value)">
                  <option value="minore" ${acc.tipo === 'minore' ? 'selected' : ''}>Minore Under 18 (12€)</option>
                  <option value="adulto_standard" ${acc.tipo === 'adulto_standard' ? 'selected' : ''}>Adulto Non Socio (15€ - con Assicurazione)</option>
                  <option value="adulto_socio" ${acc.tipo === 'adulto_socio' ? 'selected' : ''}>Adulto Socio OASY CSEN (12€)</option>
                </select>
              </div>

              <div class="form-grid-2">
                <div class="form-group" style="margin-bottom:0;">
                  <label class="form-label" style="font-size:11px;">Nome e Cognome *</label>
                  <input type="text" class="form-input" style="padding:8px 10px; font-size:13px;" value="${acc.nome}" placeholder="es. Luca Rossi" oninput="updateAccField(${acc.id}, 'nome', this.value)" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                  <label class="form-label" style="font-size:11px;">Codice Fiscale *</label>
                  <input type="text" class="form-input font-mono" style="padding:8px 10px; font-size:13px; text-transform:uppercase;" value="${acc.codiceFiscale}" placeholder="16 CARATTERI" maxlength="16" oninput="updateAccField(${acc.id}, 'codiceFiscale', this.value.toUpperCase())" />
                </div>
              </div>
            </div>
          `;
        }).join('');

        recalculateTotal();
      }

      function recalculateTotal() {
        var isSocio = document.querySelector('input[name="isSocio"]:checked').value.includes('Si');
        var quotaMain = isSocio ? 10 : 10;
        var total = quotaMain;

        accompagnatori.forEach(function(a) { total += a.costo; });
        currentTotalEuro = total;

        document.getElementById('quota-display').textContent = total + "€";
        var count = 1 + accompagnatori.length;
        document.getElementById('quota-detail-text').textContent = count + " Partecipanti registrati (" + total + "€)";
      }

      function validateAll() {
        var nome = document.getElementById('nome').value.trim();
        var email = document.getElementById('email').value.trim();
        var tel = document.getElementById('telefono').value.trim();
        var isSocio = document.querySelector('input[name="isSocio"]:checked').value.includes('Si');
        var cf = isSocio ? inputNumeroTessera.value.trim() : inputCF.value.trim();

        if (!nome || !email || !tel) {
          alert("Per favore compila Nome, Email e Telefono del partecipante principale.");
          return false;
        }

        if (!cf) {
          alert(isSocio ? "Inserisci il Codice Fiscale o N° Tessera del socio OASY." : "Inserisci il Codice Fiscale per l'assicurazione CSEN.");
          return false;
        }

        for (var i = 0; i < accompagnatori.length; i++) {
          if (!accompagnatori[i].nome || !accompagnatori[i].codiceFiscale) {
            alert("Compila Nome e Codice Fiscale per ciascun partecipante aggiuntivo.");
            return false;
          }
        }

        return true;
      }

      async function sendRegistration() {
        if (!validateAll()) return;

        var btnOnsite = document.getElementById('btn-book-onsite');
        btnOnsite.disabled = true;

        var isSocio = document.querySelector('input[name="isSocio"]:checked').value.includes('Si');
        var cfMain = isSocio ? inputNumeroTessera.value.toUpperCase() : inputCF.value.toUpperCase();
        var totQuota = currentTotalEuro + "€";
        var userEmail = document.getElementById('email').value.trim();
        var userName = document.getElementById('nome').value.trim();
        var userEvento = document.getElementById('evento').value;

        var listaAccompagnatori = accompagnatori.map(function(a) {
          return {
            nome: a.nome,
            codiceFiscale: a.codiceFiscale,
            tipo: a.tipo,
            quota: a.quota
          };
        });

        var payload = {
          evento: userEvento,
          nome: userName,
          email: userEmail,
          telefono: document.getElementById('telefono').value,
          codiceFiscale: cfMain,
          isSocio: isSocio,
          quotaPrincipale: (isSocio ? 10 : 10) + "€",
          quotaTotale: totQuota,
          note: document.getElementById('note').value,
          statoPagamento: "Da saldare al ritrovo",
          accompagnatori: listaAccompagnatori
        };

        btnOnsite.innerText = "Registrazione in corso...";

        try {
          // 1. Salvataggio su Google Sheets
          fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          }).catch(function(e) { console.warn("Google Sheet sync warning:", e); });

          // 2. Feedback a video
          setTimeout(function() {
            document.getElementById('form-container').style.display = 'none';
            document.getElementById('box-onsite-success').style.display = 'block';
            var totCount = 1 + accompagnatori.length;
            document.getElementById('success-message-text').textContent = 
              "Registrati " + totCount + " partecipanti per un totale di " + totQuota + ". Iscrizione confermata. Vi aspettiamo al banchetto ritrovo per il saldo (Contanti o POS) e il ritiro dei cappellini!";
          }, 600);

        } catch (err) {
          alert("Attenzione: " + err.message);
          btnOnsite.disabled = false;
          btnOnsite.innerText = "Conferma Iscrizione & Salda al Ritrovo \u2192";
        }
      }

      document.getElementById('btn-book-onsite').addEventListener('click', function() {
        sendRegistration();
      });

      updateMainUserUI();
    </script>
  </body>
</html>