---
// src/pages/index.astro - OASY ASD: Home Ufficiale con Dati Statutari e Footer Conforme
---
<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OASY | Outdoor Activity Sassello &amp; You</title>
    
    <!-- Meta SEO & Social Preview -->
    <meta name="title" content="OASY ASD | Outdoor Activity Sassello & You" />
    <meta name="description" content="Associazione sportiva outdoor a Sassello: MTB, trail running, trekking e tutela dei sentieri nel Beigua Geopark UNESCO." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://asdoasy.it/" />
    <meta property="og:title" content="OASY ASD | Segui il tuo istinto a Sassello" />
    <meta property="og:description" content="Community outdoor, uscite ufficiali, tracciati GPX gratuiti e rispetto del territorio." />
    <meta property="og:image" content="/hero-bg.jpg" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@600;800&display=swap" rel="stylesheet" />

    <style is:inline>
      :root {
        --rock: #111110;
        --trail: #2d2d20;
        --energy: #c7cf0b;
        --sand: #f9f7ed;
        --sand-card: #ffffff;
        --water: #a5d5d7;
        --autumn: #d96919;
        --border-subtle: rgba(45, 45, 32, 0.12);
        --ig-gradient: linear-gradient(135deg, var(--energy) 0%, var(--autumn) 100%);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
      }
      body {
        background-color: var(--sand);
        color: var(--rock);
        font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
        line-height: 1.5;
      }
      .font-mono { font-family: 'JetBrains Mono', monospace; }
      .tag-mono {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      /* ========================================================
         1. DESKTOP: FULL-BLEED (>= 980px)
         ======================================================== */
      @media (min-width: 980px) {
        .mobile-only { display: none !important; }

        .top-ticker {
          width: 100%;
          background: var(--trail);
          color: var(--sand);
          font-size: 11px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 1.5px;
          padding: 8px 3vw;
          display: flex;
          justify-content: space-between;
        }

        header.desktop-header {
          position: sticky;
          top: 0;
          z-index: 100;
          width: 100%;
          background: rgba(249, 247, 237, 0.96);
          backdrop-filter: blur(14px);
          border-bottom: 1px solid var(--border-subtle);
          padding: 16px 3vw;
          display: flex;
          justify-content: space-between;
          align-items: center;
        }

        .logo-img { height: 52px; width: auto; display: block; }

        nav.desktop-nav {
          display: flex;
          gap: 3vw;
          font-size: 13px;
          text-transform: uppercase;
          font-weight: 800;
          letter-spacing: 1px;
        }

        nav.desktop-nav a {
          color: var(--trail);
          text-decoration: none;
          transition: color 0.2s;
        }
        nav.desktop-nav a:hover { color: var(--rock); }

        .desktop-canvas {
          width: 100%;
          max-width: none;
          margin: 0;
          padding: 32px 3vw 100px;
        }

        .desktop-single-hero {
          position: relative;
          width: 100%;
          border-radius: 28px;
          overflow: hidden;
          background-color: var(--rock);
          background-image: 
            linear-gradient(180deg, rgba(17,17,16,0.84) 0%, rgba(17,17,16,0.58) 55%, rgba(17,17,16,0.92) 100%),
            url('/hero-bg.jpg');
          background-position: center;
          background-size: cover;
          padding: 76px 56px 52px;
          margin-bottom: 56px;
          color: var(--sand);
          box-shadow: 0 16px 44px rgba(17,17,16,0.12);
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          min-height: 520px;
        }

        .desktop-hero-top { max-width: 980px; }

        .desktop-hero-title {
          font-size: clamp(2.8rem, 4.4vw, 4.6rem);
          font-weight: 900;
          text-transform: uppercase;
          line-height: 0.98;
          margin: 18px 0;
          letter-spacing: -0.5px;
        }

        .desktop-hero-p {
          font-size: 19px;
          max-width: 820px;
          opacity: 0.94;
          line-height: 1.6;
          margin-bottom: 36px;
        }

        .desktop-hero-bottom-bar {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          flex-wrap: wrap;
          gap: 24px;
          padding-top: 10px;
        }

        .desktop-hero-metrics {
          display: flex;
          gap: 48px;
        }

        .metric-unit span.num {
          font-family: 'JetBrains Mono', monospace;
          font-size: 34px;
          font-weight: 900;
          color: var(--energy);
          line-height: 1;
          display: block;
        }

        .metric-unit span.lbl {
          font-size: 11px;
          text-transform: uppercase;
          letter-spacing: 1px;
          opacity: 0.75;
          margin-top: 6px;
          display: block;
        }

        .desktop-about-section {
          position: relative;
          background: #ffffff;
          border: 1.5px solid var(--border-subtle);
          border-radius: 28px;
          overflow: hidden;
          margin-bottom: 64px;
          padding: 56px 52px;
          box-shadow: 0 12px 36px rgba(45, 45, 32, 0.05);
        }

        .about-integrated-bg {
          position: absolute;
          top: 0;
          right: 0;
          width: 50%;
          height: 100%;
          pointer-events: none;
          z-index: 1;
          overflow: hidden;
          opacity: 0.22;
          mask-image: linear-gradient(to left, black 40%, transparent 100%);
          -webkit-mask-image: linear-gradient(to left, black 40%, transparent 100%);
        }

        .about-integrated-bg img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: center right;
          display: block;
        }

        .about-content-wrapper {
          position: relative;
          z-index: 2;
          width: 100%;
        }

        .about-intro {
          font-size: 18px;
          color: var(--trail);
          line-height: 1.65;
          max-width: 620px;
          margin-bottom: 34px;
        }

        .about-pillars-grid {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 24px;
          margin-bottom: 24px;
          width: 100%;
        }

        .about-pillar-card {
          background: rgba(249, 247, 237, 0.94);
          backdrop-filter: blur(12px);
          border: 1.5px solid var(--border-subtle);
          border-radius: 20px;
          padding: 28px 30px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          box-shadow: 0 4px 18px rgba(45, 45, 32, 0.04);
        }

        .about-pillar-card h3 {
          font-size: 21px;
          font-weight: 900;
          text-transform: uppercase;
          margin-bottom: 10px;
          color: var(--rock);
        }

        .about-pillar-card p {
          font-size: 14.5px;
          color: var(--trail);
          line-height: 1.65;
        }

        .about-commitment-card-dark {
          width: 100%;
          background: var(--trail);
          color: var(--sand);
          border: 1.5px solid var(--energy);
          border-radius: 20px;
          padding: 28px 34px;
          display: flex;
          align-items: center;
          gap: 24px;
          box-shadow: 0 8px 24px rgba(17,17,16,0.14);
        }

        .about-commitment-card-dark h4 {
          font-size: 19px;
          font-weight: 900;
          text-transform: uppercase;
          color: var(--energy);
        }

        .about-commitment-card-dark p {
          font-size: 14px;
          opacity: 0.92;
          line-height: 1.6;
          margin-top: 4px;
          color: var(--sand);
        }

        .desktop-rides-grid {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 28px;
          margin-bottom: 64px;
          width: 100%;
        }

        .desktop-ride-card {
          background: #ffffff;
          border: 1px solid var(--border-subtle);
          border-radius: 24px;
          overflow: hidden;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          box-shadow: 0 8px 24px rgba(17,17,16,0.04);
          transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .desktop-ride-card:hover {
          transform: translateY(-3px);
          border-color: var(--energy);
        }

        .desktop-ride-media {
          position: relative;
          height: 260px;
          width: 100%;
          background: var(--rock);
          overflow: hidden;
        }

        .desktop-ride-media img {
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: transform 0.3s ease;
        }

        .desktop-ride-card:hover .desktop-ride-media img {
          transform: scale(1.03);
        }

        .desktop-ride-body {
          padding: 28px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          flex-grow: 1;
        }

        .desktop-trails-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 22px;
          margin-bottom: 24px;
          width: 100%;
        }

        .desktop-trail-card {
          background: #ffffff;
          border: 1.5px solid var(--border-subtle);
          border-radius: 20px;
          padding: 24px;
          cursor: pointer;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .desktop-trail-card:hover {
          transform: translateY(-2px);
          border-color: var(--rock);
        }

        .desktop-trail-card.active {
          border-color: var(--rock);
          box-shadow: 0 0 0 2px var(--energy), 0 8px 24px rgba(45, 45, 32, 0.08);
        }

        .desktop-komoot-container {
          width: 100%;
          background: #ffffff;
          border-radius: 24px;
          border: 1px solid var(--border-subtle);
          overflow: hidden;
          margin-bottom: 64px;
        }

        .desktop-komoot-container iframe {
          width: 100%;
          height: 640px;
          border: none;
          display: block;
        }

        .desktop-membership-card {
          position: relative;
          background-color: var(--trail);
          color: var(--sand);
          border-radius: 26px;
          padding: 52px 48px;
          display: grid;
          grid-template-columns: 1.3fr 0.7fr;
          gap: 48px;
          align-items: center;
          margin-bottom: 64px;
          overflow: hidden;
          border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .desktop-membership-card::before {
          content: "";
          position: absolute;
          inset: 0;
          background-image: url('/oasy-sentieri-graphic.jpg');
          background-size: cover;
          background-position: center right;
          opacity: 0.22;
          pointer-events: none;
        }

        .desktop-membership-card > * { position: relative; z-index: 2; }

        .desktop-benefits-list {
          background: rgba(17, 17, 16, 0.76);
          backdrop-filter: blur(12px);
          border: 1px solid rgba(255, 255, 255, 0.14);
          border-radius: 20px;
          padding: 26px;
          display: flex;
          flex-direction: column;
          gap: 16px;
        }

        .benefit-row { display: flex; gap: 14px; align-items: flex-start; }
        .benefit-icon {
          width: 26px;
          height: 26px;
          border-radius: 7px;
          background: var(--energy);
          color: var(--rock);
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          font-weight: 900;
          font-size: 13px;
        }

        .tier-label {
          font-family: 'JetBrains Mono', monospace;
          font-size: 11px;
          font-weight: 800;
          letter-spacing: 1.2px;
          text-transform: uppercase;
          color: var(--trail);
          opacity: 0.7;
          margin-bottom: 14px;
          display: block;
        }

        .main-partner-card {
          background: #ffffff;
          border: 2px solid var(--rock);
          border-radius: 26px;
          padding: 36px;
          margin-bottom: 36px;
          display: grid;
          grid-template-columns: 1.3fr 0.7fr;
          gap: 32px;
          align-items: center;
        }

        .badge-main {
          background: var(--energy);
          color: var(--rock);
          font-size: 10px;
          font-weight: 800;
          letter-spacing: 1px;
          text-transform: uppercase;
          padding: 4px 10px;
          border-radius: 999px;
          display: inline-block;
          margin-bottom: 8px;
        }

        .gold-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 22px;
          margin-bottom: 36px;
        }

        .gold-card {
          background: #ffffff;
          border: 1.5px solid var(--border-subtle);
          border-radius: 20px;
          padding: 26px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          transition: transform 0.2s, border-color 0.2s;
        }

        .gold-category {
          font-size: 10px;
          font-weight: 800;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          color: var(--trail);
          background: rgba(165, 213, 215, 0.45);
          padding: 4px 10px;
          border-radius: 6px;
          display: inline-block;
          margin-bottom: 12px;
          align-self: flex-start;
        }

        .gold-card h4 {
          font-size: 20px;
          font-weight: 800;
          text-transform: uppercase;
          color: var(--rock);
        }

        .gold-card p {
          font-size: 13px;
          color: var(--trail);
          opacity: 0.85;
          margin-top: 6px;
          line-height: 1.5;
        }

        .gold-meta {
          margin-top: 20px;
          border-top: 1px solid var(--border-subtle);
          padding-top: 12px;
          display: flex;
          justify-content: space-between;
          font-size: 11px;
          color: var(--trail);
          opacity: 0.75;
        }

        .supporters-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 16px;
          margin-bottom: 36px;
        }

        .supporter-pill {
          background: #ffffff;
          border: 1px solid var(--border-subtle);
          border-radius: 16px;
          padding: 16px 20px;
          display: flex;
          align-items: center;
          gap: 14px;
        }

        .supporter-dot {
          width: 10px;
          height: 10px;
          border-radius: 50%;
          background: var(--autumn);
          flex-shrink: 0;
        }

        .supporter-info h5 {
          font-size: 14px;
          font-weight: 800;
          text-transform: uppercase;
          color: var(--rock);
        }

        .supporter-info span {
          font-size: 11px;
          color: var(--trail);
          opacity: 0.7;
          display: block;
        }

        .support-banner {
          background: var(--trail);
          color: var(--sand);
          border-radius: 22px;
          padding: 32px 36px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          flex-wrap: wrap;
          gap: 20px;
        }

        .btn-partner-mail {
          background: var(--energy);
          color: var(--rock);
          font-weight: 800;
          font-size: 11px;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          padding: 13px 24px;
          border-radius: 10px;
          text-decoration: none;
          display: inline-flex;
          align-items: center;
          gap: 8px;
        }
      }

      /* ========================================================
         2. VISTA MOBILE (< 980px)
         ======================================================== */
      @media (max-width: 979px) {
        .desktop-only { display: none !important; }

        .ig-top-bar {
          position: sticky;
          top: 0;
          z-index: 100;
          background: rgba(249, 247, 237, 0.98);
          backdrop-filter: blur(14px);
          border-bottom: 1px solid var(--border-subtle);
          padding: 14px 16px;
          display: flex;
          justify-content: space-between;
          align-items: center;
        }

        .ig-profile-handle {
          font-size: 18px;
          font-weight: 900;
          letter-spacing: -0.4px;
          display: flex;
          align-items: center;
          gap: 6px;
          color: var(--rock);
        }

        .ig-badge-check {
          background: var(--energy);
          color: var(--rock);
          width: 17px;
          height: 17px;
          border-radius: 50%;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          font-size: 10px;
          font-weight: 900;
        }

        .ig-container {
          padding: 14px 14px 90px;
        }

        .ig-profile-card {
          background: #ffffff;
          border: 1.5px solid var(--border-subtle);
          border-radius: 24px;
          padding: 20px 18px 18px;
          margin-bottom: 20px;
          box-shadow: 0 6px 20px rgba(45, 45, 32, 0.04);
        }

        .ig-header-main {
          display: grid;
          grid-template-columns: auto 1fr;
          gap: 18px;
          align-items: center;
          margin-bottom: 16px;
        }

        .ig-story-ring {
          padding: 3px;
          border-radius: 50%;
          background: var(--ig-gradient);
          display: inline-flex;
        }

        /* Avatar Mobile a sfondo chiaro con contrasto ottimizzato */
        .ig-avatar-circle {
          width: 76px;
          height: 76px;
          border-radius: 50%;
          background: #ffffff;
          border: 2px solid #ffffff;
          display: flex;
          align-items: center;
          justify-content: center;
          overflow: hidden;
          box-shadow: 0 3px 10px rgba(17, 17, 16, 0.12);
        }

        .ig-avatar-circle img {
          width: 84%;
          height: 84%;
          object-fit: contain;
          display: block;
        }

        .ig-stats-grid {
          display: flex;
          justify-content: space-around;
          text-align: center;
        }

        .ig-stat-num {
          font-family: 'JetBrains Mono', monospace;
          font-size: 20px;
          font-weight: 900;
          color: var(--rock);
          line-height: 1.1;
        }

        .ig-stat-label {
          font-size: 11px;
          color: var(--trail);
          opacity: 0.75;
          text-transform: uppercase;
          font-weight: 700;
          margin-top: 2px;
        }

        .ig-bio-block {
          font-size: 13.5px;
          color: var(--trail);
          line-height: 1.5;
          border-top: 1px solid rgba(45, 45, 32, 0.08);
          padding-top: 14px;
          margin-bottom: 16px;
        }

        .ig-bio-name {
          font-size: 15px;
          font-weight: 900;
          color: var(--rock);
          text-transform: uppercase;
          margin-bottom: 4px;
        }

        .ig-bio-tagline {
          font-weight: 800;
          color: var(--autumn);
          margin-bottom: 6px;
          display: block;
        }

        .ig-bio-list {
          list-style: none;
          display: flex;
          flex-direction: column;
          gap: 4px;
        }

        .ig-bio-list li {
          display: flex;
          align-items: center;
          gap: 6px;
        }

        .ig-action-grid {
          display: grid;
          grid-template-columns: 1.2fr 0.8fr;
          gap: 10px;
        }

        .ig-action-btn-main {
          background: var(--rock);
          color: var(--sand);
          font-family: 'JetBrains Mono', monospace;
          font-size: 11.5px;
          font-weight: 800;
          text-transform: uppercase;
          text-align: center;
          padding: 12px 10px;
          border-radius: 12px;
          text-decoration: none;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .ig-action-btn-sub {
          background: #ffffff;
          color: var(--rock);
          border: 1.5px solid var(--border-subtle);
          font-family: 'JetBrains Mono', monospace;
          font-size: 11.5px;
          font-weight: 800;
          text-transform: uppercase;
          text-align: center;
          padding: 12px 10px;
          border-radius: 12px;
          text-decoration: none;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .section-header-mobile {
          display: flex;
          justify-content: space-between;
          align-items: baseline;
          margin: 28px 4px 12px;
        }

        .section-header-mobile h3 {
          font-family: 'JetBrains Mono', monospace;
          font-size: 12.5px;
          font-weight: 900;
          text-transform: uppercase;
          letter-spacing: 0.8px;
          color: var(--rock);
          display: flex;
          align-items: center;
          gap: 6px;
        }

        .section-header-mobile span {
          font-size: 11px;
          color: var(--trail);
          opacity: 0.7;
          font-family: 'JetBrains Mono', monospace;
        }

        .events-carousel {
          display: flex;
          gap: 14px;
          overflow-x: auto;
          scroll-snap-type: x mandatory;
          padding: 4px 2px 14px;
          margin-bottom: 10px;
          scrollbar-width: none;
        }
        .events-carousel::-webkit-scrollbar { display: none; }

        .carousel-card {
          flex: 0 0 85%;
          scroll-snap-align: start;
          scroll-margin-left: 14px;
          background: #ffffff;
          border: 1.5px solid var(--border-subtle);
          border-radius: 20px;
          overflow: hidden;
          box-shadow: 0 4px 16px rgba(45, 45, 32, 0.05);
          display: flex;
          flex-direction: column;
        }

        .carousel-card-media {
          position: relative;
          width: 100%;
          height: 160px;
          background: var(--rock);
        }

        .carousel-card-media img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }

        .badge-date-pill {
          position: absolute;
          top: 10px;
          left: 10px;
          background: var(--autumn);
          color: #ffffff;
          font-family: 'JetBrains Mono', monospace;
          font-size: 10px;
          font-weight: 900;
          padding: 4px 10px;
          border-radius: 999px;
        }

        .badge-price-pill {
          position: absolute;
          bottom: 10px;
          right: 10px;
          background: var(--energy);
          color: var(--rock);
          font-family: 'JetBrains Mono', monospace;
          font-size: 10px;
          font-weight: 900;
          padding: 4px 10px;
          border-radius: 999px;
        }

        .carousel-card-body {
          padding: 14px 16px 16px;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          flex: 1;
        }

        .carousel-card-body h4 {
          font-size: 16px;
          font-weight: 900;
          text-transform: uppercase;
          line-height: 1.2;
          color: var(--rock);
          margin-bottom: 6px;
        }

        .carousel-card-body p {
          font-size: 12.5px;
          color: var(--trail);
