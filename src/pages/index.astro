    <script is:inline>
      var komootTours = [
        "https://www.komoot.com/it-it/smarttour/e1238605259/anello-della-deiva/embed?hl=it&layout=classic&profile=1",
        "https://www.komoot.com/it-it/smarttour/e2546782788/da-sassello-al-monte-beigua-percorsi-666c-e-617/embed?hl=it&layout=classic&profile=1",
        "https://www.komoot.com/it-it/smarttour/e1239404027/sassello-e-rifugio-la-sciverna-giro-ad-anello/embed?hl=it&layout=classic&profile=1"
      ];

      window.switchDesktopKomoot = function(index) {
        var iframe = document.getElementById('desktop-komoot-iframe');
        if (!iframe) return;
        iframe.src = komootTours[index];

        for (var i = 0; i < 3; i++) {
          var card = document.getElementById('d-tab-' + i);
          if (card) {
            var statusSpan = card.querySelector('.d-status');
            if (i === index) {
              card.classList.add('active');
              if (statusSpan) {
                statusSpan.textContent = '• Attivo in Mappa';
                statusSpan.style.color = 'var(--rock)';
                statusSpan.style.opacity = '1';
              }
            } else {
              card.classList.remove('active');
              if (statusSpan) {
                statusSpan.textContent = 'Clicca per visualizzare';
                statusSpan.style.color = 'var(--trail)';
                statusSpan.style.opacity = '0.6';
              }
            }
          }
        }
      };
    </script>
